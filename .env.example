DATABASE_URL="postgresql://postgres:[password]@[host]:6543/postgres?pgbouncer=true"
# For serverless deployments consider appending &connection_limit=5&pool_timeout=10 to the
# pooled URL above -- every serverless instance opens its own pool, and small explicit
# pools keep you under Supabase's connection ceiling (audit L16).
DIRECT_URL="postgresql://postgres:[password]@[host]:5432/postgres"
# REQUIRED in production (boot fails without it; min 32 chars). Dev has a fallback.
NEXTAUTH_SECRET="generate-a-long-random-secret"
# Local development only. next-auth's detectOrigin() returns this before it looks at the
# forwarded host, so a hosted deployment carrying "http://localhost:3000" sends real users
# to their own machine on sign-out. In hosting, either set this to the production origin
# (https://your-domain) or delete it and set AUTH_TRUST_HOST=true, which derives the origin
# per request and so also works on preview deployments.
NEXTAUTH_URL="http://localhost:3000"
# Optional override for absolute links built without a request in scope (cron, emails).
# See src/lib/http/base-url.ts. Falls back to NEXTAUTH_URL, then the Vercel-provided host.
APP_URL=""
GROQ_API_KEY=""
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""
# Removed with the dead realtime client (audit L10): nothing subscribes to Supabase
# channels, so the anon key no longer ships to browsers. If realtime comes back, re-add
# NEXT_PUBLIC_SUPABASE_URL / NEXT_PUBLIC_SUPABASE_ANON_KEY AND review row-level security.
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="465"
SMTP_USER=""
SMTP_APP_PASSWORD=""
# REQUIRED in production (boot fails without it; min 32 chars) -- the /api/internal/jobs
# endpoints are fail-closed without it, so a missing value means silently-dead background
# jobs. Generate with: openssl rand -base64 32
CRON_SECRET=""
